// Copiá este archivo a `Secrets.xcconfig` y completá tus valores.
//   cp Configuration/Secrets.example.xcconfig Configuration/Secrets.xcconfig
// `Secrets.xcconfig` está en .gitignore.

// Tu Team ID de Apple Developer (Membership Details).
DEVELOPMENT_TEAM = ABCDE12345

// Bundle ID propio (tiene que ser único en el App Store).
APP_BUNDLE_ID = com.tudominio.carlyrics

// Client ID de tu app en https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID = 0123456789abcdef0123456789abcdef

// Esquema de retorno: registralo igual en el dashboard de Spotify como
// Redirect URI -> carlyrics://callback
SPOTIFY_REDIRECT_SCHEME = carlyrics
